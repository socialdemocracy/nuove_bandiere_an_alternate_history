title: Sturzo's gone!
subtitle: The Vatican has dismissed our "friend" over at  the PPI.
view-if: year == 1923 and month = 7 and week = 1 and (roman_question_answered = 0 or pope = "Del Val") and ppi_leader == "Sturzo" and pnf_in_government and papal_relation < 79
frequency: 1000
new-page: true
max-visits: 1
on-arrival: ppi_leader = "De Gasperi" if ppi_leader == "Sturzo";
